# Copy this file to ".env" and fill in the values.
#   cp env.example .env

# --- Twilio (free trial gives ~$15 credit, no card) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Your public websocket URL from ngrok, WITH the /ws path.
# Get it by running:  ngrok http 7860
# Example: wss://loud-otter-1234.ngrok-free.app/ws
PUBLIC_WS_URL=wss://your-subdomain.ngrok-free.app/ws

# --- AI services (all have a free tier / free credits) ---
# Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Deepgram (speech-to-text): https://console.deepgram.com  ($200 free credit)
DEEPGRAM_API_KEY=

# Cartesia (text-to-speech): https://play.cartesia.ai  (free tier)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# --- Your business ---
BUSINESS_NAME=Acme Co
